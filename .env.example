# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These values are not secret; they ship in every Firebase web app.
VITE_FIREBASE_API_KEY=
# Use the hosting domain (<project-id>.web.app) so Google sign-in works in iPhone home-screen apps.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to 1 to run against local emulators (no Firebase project needed).
VITE_USE_EMULATORS=0
