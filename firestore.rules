rules_version = '2';

// Every family's data lives under /families/{familyId}. Access requires a
// member document there; nobody can create their own membership except the
// founder of a brand-new family. Everyone else joins in three steps:
//   1. an admin creates an invite (/invites/{code})
//   2. the invitee claims it and files a join request (one batch)
//   3. an admin approves the request and creates the membership (one batch)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function familyPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function memberPath(fid, uid) { return /databases/$(database)/documents/families/$(fid)/members/$(uid); }
    function requestPath(fid, uid) { return /databases/$(database)/documents/families/$(fid)/joinRequests/$(uid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }

    function isMember(fid) { return signedIn() && exists(memberPath(fid, me())); }
    function myRole(fid) { return get(memberPath(fid, me())).data.role; }
    function isAdmin(fid) { return isMember(fid) && myRole(fid) == 'admin'; }

    function data() { return request.resource.data; }
    function onlyKeys(keys) { return data().keys().hasOnly(keys); }
    function changedKeys() { return data().diff(resource.data).affectedKeys(); }
    function validRole(r) { return r in ['admin', 'member', 'child']; }
    function shortString(v, max) { return v is string && v.size() <= max; }

    // ---------- personal profile ----------
    match /users/{userId} {
      allow read: if signedIn() && me() == userId;
      allow create, update: if signedIn() && me() == userId
        && onlyKeys(['familyId', 'startScreen'])
        && (!('familyId' in data()) || data().familyId == null || shortString(data().familyId, 64))
        && (!('startScreen' in data()) || data().startScreen in ['home', 'list', 'tasks', 'calendar', 'lists', 'chat']);
      allow delete: if false;

      // Phones registered for notifications. Only the owner sees or changes them.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && me() == userId;
        allow create, update: if signedIn() && me() == userId
          && onlyKeys(['token', 'platform', 'createdAt'])
          && shortString(data().token, 4096) && data().token.size() > 0
          && data().platform in ['ios', 'android', 'web'];
      }
    }

    // ---------- invites (top level so a short code can be typed in) ----------
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && isAdmin(resource.data.familyId);
      allow create: if signedIn()
        && isAdmin(data().familyId)
        && onlyKeys(['familyId', 'role', 'createdBy', 'createdAt', 'expiresAt', 'usedBy'])
        && data().createdBy == me()
        && validRole(data().role)
        && data().usedBy == null
        && data().createdAt == request.time
        && data().expiresAt is timestamp
        && data().expiresAt <= request.time + duration.value(8, 'd')
        && code.size() >= 6 && code.size() <= 32;
      // The invitee claims an unused, unexpired invite in the same batch that
      // creates their join request.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && changedKeys().hasOnly(['usedBy'])
        && data().usedBy == me()
        && getAfter(requestPath(resource.data.familyId, me())).data.inviteCode == code;
      allow delete: if signedIn() && isAdmin(resource.data.familyId);
    }

    match /families/{fid} {
      allow read: if isMember(fid);
      // Founding a family: the family doc and the founder's admin membership
      // are written together, and only if the family id is unused.
      allow create: if signedIn()
        && onlyKeys(['name', 'createdBy', 'createdAt', 'deptOrder'])
        && data().createdBy == me()
        && data().createdAt == request.time
        && shortString(data().name, 60) && data().name.size() > 0
        && data().deptOrder is list
        && getAfter(memberPath(fid, me())).data.role == 'admin';
      allow update: if isAdmin(fid) && changedKeys().hasOnly(['name', 'deptOrder'])
        || isMember(fid) && changedKeys().hasOnly(['deptOrder']);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(fid);
        allow create: if signedIn()
          && onlyKeys(['role', 'displayName', 'email', 'photoURL', 'joinedAt'])
          && validRole(data().role)
          && data().joinedAt == request.time
          && (
            // founder
            (uid == me() && data().role == 'admin'
              && !exists(familyPath(fid))
              && getAfter(familyPath(fid)).data.createdBy == me())
            ||
            // approval of a pending join request, in the same batch
            (uid != me() && isAdmin(fid)
              && get(requestPath(fid, uid)).data.status == 'pending'
              && getAfter(requestPath(fid, uid)).data.status == 'approved'
              && data().role == get(requestPath(fid, uid)).data.role)
          );
        allow update: if isAdmin(fid) && uid != me()
          && changedKeys().hasOnly(['role']) && validRole(data().role);
        // Admins remove others; anyone may leave.
        allow delete: if isAdmin(fid) && uid != me() || signedIn() && uid == me();
      }

      match /joinRequests/{uid} {
        allow read: if signedIn() && uid == me() || isAdmin(fid);
        allow create: if signedIn() && uid == me()
          && !isMember(fid)
          && onlyKeys(['inviteCode', 'role', 'displayName', 'email', 'photoURL', 'status', 'createdAt'])
          && data().status == 'pending'
          && data().createdAt == request.time
          && data().email == request.auth.token.email
          && shortString(data().displayName, 80)
          && get(invitePath(data().inviteCode)).data.familyId == fid
          && get(invitePath(data().inviteCode)).data.usedBy == null
          && get(invitePath(data().inviteCode)).data.expiresAt > request.time
          && getAfter(invitePath(data().inviteCode)).data.usedBy == me()
          && data().role == get(invitePath(data().inviteCode)).data.role;
        allow update: if isAdmin(fid)
          && resource.data.status == 'pending'
          && changedKeys().hasOnly(['status', 'decidedBy', 'decidedAt'])
          && data().status in ['approved', 'rejected']
          && data().decidedBy == me()
          && data().decidedAt == request.time;
        allow delete: if signedIn() && uid == me() || isAdmin(fid);
      }

      // ---------- shopping list ----------
      match /items/{itemId} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['name', 'norm', 'qty', 'category', 'checked', 'deleted',
                       'addedAt', 'updatedAt', 'updatedBy'])
          && shortString(data().name, 80) && data().name.size() > 0
          && shortString(data().norm, 80)
          && shortString(data().qty, 30)
          && shortString(data().category, 40)
          && data().checked is bool
          && data().deleted is bool
          && data().updatedBy == me();
        // Items are soft-deleted so they can be restored.
        allow delete: if false;
      }

      // ---------- tasks ----------
      match /tasks/{taskId} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['title', 'assignee', 'due', 'done', 'deleted',
                       'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
          && shortString(data().title, 120) && data().title.size() > 0
          && (data().assignee == null || shortString(data().assignee, 128))
          && (data().due == null || data().due is string && data().due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && data().done is bool
          && data().deleted is bool
          && data().updatedBy == me();
        allow delete: if false;
      }

      // ---------- calendar events ----------
      match /events/{eventId} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['title', 'date', 'endDate', 'repeat', 'repeatUntil', 'time', 'location', 'people', 'deleted',
                       'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
          && shortString(data().title, 120) && data().title.size() > 0
          && data().date is string && data().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (!('endDate' in data()) || data().endDate == ''
              || (data().endDate is string && data().endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data().endDate > data().date))
          && (!('repeat' in data()) || data().repeat in ['', 'weekly'])
          && (!('repeatUntil' in data()) || data().repeatUntil == ''
              || (data().repeatUntil is string && data().repeatUntil.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data().repeatUntil > data().date))
          && data().time is string && (data().time == '' || data().time.matches('^[0-9]{2}:[0-9]{2}$'))
          && shortString(data().location, 120)
          && data().people is list && data().people.size() <= 20
          && data().deleted is bool
          && data().updatedBy == me();
        allow delete: if false;
      }

      // Family corrections to the built-in product dictionary.
      match /categoryOverrides/{norm} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['category']) && shortString(data().category, 40);
        allow delete: if isMember(fid);
      }

      // ---------- checklists ("תיק למכון") and their lines ----------
      match /lists/{listId} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['title', 'emoji', 'categories', 'kind', 'body', 'pinned', 'parentId', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
          && shortString(data().title, 60) && data().title.size() > 0
          && shortString(data().emoji, 16)
          && (!('categories' in data()) || (data().categories is list && data().categories.size() <= 30))
          && (!('kind' in data()) || data().kind in ['note', 'folder'])
          && (!('parentId' in data()) || shortString(data().parentId, 64))
          && (!('body' in data()) || shortString(data().body, 5000))
          && (!('pinned' in data()) || data().pinned is bool)
          && data().updatedBy == me();
        allow delete: if isMember(fid);
      }
      // A PDF or photo on a note, stored as a JPEG; added or removed, never edited.
      match /noteFiles/{fileId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid)
          && onlyKeys(['noteId', 'image', 'name', 'createdBy', 'createdAt'])
          && shortString(data().noteId, 64)
          && exists(/databases/$(database)/documents/families/$(fid)/lists/$(data().noteId))
          && shortString(data().image, 950000)
          && data().image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && shortString(data().name, 120)
          && shortString(data().createdBy, 128);
        allow delete: if isMember(fid);
      }

      // A private note: only the members in `viewers` can read, edit or delete
      // it, and only its creator (always a viewer) can change who they are.
      match /privateNotes/{noteId} {
        allow read, delete: if isMember(fid) && me() in resource.data.viewers;
        allow create: if isMember(fid) && data().createdBy == me() && validPrivateNote();
        allow update: if isMember(fid) && me() in resource.data.viewers && validPrivateNote()
          && data().createdBy == resource.data.createdBy
          && (data().viewers == resource.data.viewers || resource.data.createdBy == me());

        function validPrivateNote() {
          return onlyKeys(['title', 'emoji', 'kind', 'body', 'pinned', 'parentId', 'viewers', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy'])
            && data().kind == 'note'
            && shortString(data().title, 60) && data().title.size() > 0
            && shortString(data().emoji, 16)
            && shortString(data().body, 5000)
            && data().pinned is bool
            && shortString(data().parentId, 64)
            && data().viewers is list && data().viewers.size() >= 1 && data().viewers.size() <= 20
            && data().createdBy in data().viewers
            && data().updatedBy == me();
        }

        match /files/{fileId} {
          function canSee() {
            return isMember(fid)
              && me() in get(/databases/$(database)/documents/families/$(fid)/privateNotes/$(noteId)).data.viewers;
          }
          allow read, delete: if canSee();
          allow create: if canSee()
            && onlyKeys(['image', 'name', 'createdBy', 'createdAt'])
            && shortString(data().image, 950000)
            && data().image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
            && shortString(data().name, 120)
            && shortString(data().createdBy, 128);
        }
      }
      match /listEntries/{entryId} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['listId', 'text', 'done', 'order', 'category', 'updatedAt', 'updatedBy'])
          && (!('category' in data()) || shortString(data().category, 40))
          && shortString(data().listId, 64)
          && exists(/databases/$(database)/documents/families/$(fid)/lists/$(data().listId))
          && shortString(data().text, 120) && data().text.size() > 0
          && data().done is bool
          && data().order is number
          && data().updatedBy == me();
        allow delete: if isMember(fid);
      }

      // ---------- birthdays of relatives and friends ----------
      match /birthdays/{bid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid)
          && onlyKeys(['name', 'day', 'month', 'year', 'group', 'updatedAt', 'updatedBy'])
          && shortString(data().name, 60) && data().name.size() > 0
          && data().day is int && data().day >= 1 && data().day <= 31
          && data().month is int && data().month >= 1 && data().month <= 12
          && (data().year == null || (data().year is int && data().year >= 1900 && data().year <= 2100))
          && data().group in ['family', 'extended', 'friends', 'other']
          && data().updatedBy == me();
        allow delete: if isMember(fid);
      }

      // ---------- weekly timetables: one image per member ----------
      match /schedules/{uid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && (uid == me() || isAdmin(fid))
          && exists(memberPath(fid, uid))
          && onlyKeys(['image', 'updatedAt', 'updatedBy'])
          && shortString(data().image, 950000)
          && data().image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          && data().updatedBy == me();
        allow delete: if isMember(fid) && (uid == me() || isAdmin(fid));
      }

      // ---------- comments on any item ----------
      match /comments/{commentId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid)
          && onlyKeys(['targetType', 'targetId', 'text', 'image', 'notify', 'authorUid', 'authorName', 'createdAt'])
          && (!('notify' in data()) || (data().notify is list && data().notify.size() <= 20))
          && data().targetType in ['item', 'task', 'event', 'chat']
          && shortString(data().targetId, 120)
          && shortString(data().text, 1000)
          // An optional photo: a small JPEG stored inline (resized on the phone).
          && (!('image' in data()) || (shortString(data().image, 700000) && data().image.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && (data().text.size() > 0 || 'image' in data())
          && shortString(data().authorName, 80)
          && data().authorUid == me();
        allow update: if isMember(fid) && resource.data.authorUid == me()
          && changedKeys().hasOnly(['text', 'editedAt'])
          && data().editedAt == request.time
          && shortString(data().text, 1000)
          && (data().text.size() > 0 || 'image' in resource.data);
        allow delete: if isMember(fid) && resource.data.authorUid == me() || isAdmin(fid);
      }
    }
  }
}
