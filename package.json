{
  "name": "family-app",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-family \"vitest run tests/rules.test.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-family",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-family tests/run-e2e.sh",
    "test:unit": "vitest run tests/parse.test.ts tests/notify.test.ts tests/events.test.ts tests/birthdays.test.ts tests/commands.test.ts tests/mentions.test.ts tests/prices.test.ts tests/noteFormat.test.ts tests/bought.test.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.57.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^15.33.0",
    "playwright": "1.56",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true
}
